{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioLR",
  "version": "0.1.0",
  "identifier": "it.ledion.audiolr",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AudioLR",
        "width": 1100,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ledion · LR Apps",
    "category": "Music",
    "shortDescription": "Separa voce e strumenti, tutto sul computer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"]
      }
    }
  }
}
