{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IsoLR",
  "version": "0.15.0",
  "identifier": "it.ledion.audiolr",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IsoLR",
        "width": 1280,
        "height": 820,
        "minWidth": 930,
        "minHeight": 640,
        "dragDropEnabled": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ledion · LR Apps",
    "category": "Music",
    "resources": {
      "libs/onnxruntime.dll": "onnxruntime.dll",
      "libs/DirectML.dll": "DirectML.dll",
      "libs/msvcp140.dll": "msvcp140.dll",
      "libs/msvcp140_1.dll": "msvcp140_1.dll",
      "libs/vcruntime140.dll": "vcruntime140.dll",
      "libs/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "shortDescription": "Separa voce e strumenti, tutto sul computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh",
        "languages": [
          "Italian",
          "English"
        ]
      }
    }
  }
}
