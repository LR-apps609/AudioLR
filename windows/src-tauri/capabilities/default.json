{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "La finestra di IsoLR: eventi (barre di scaricamento), barra nella barra delle applicazioni, finestre di dialogo, avvisi",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-progress-bar",
    "core:window:allow-set-focus",
    "core:event:default",
    "dialog:default",
    "notification:default"
  ]
}
